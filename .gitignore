# 민감/내부 자료가 실수로 커밋되지 않도록 차단
# (실제 리스크 보고서·내보낸 데이터 등은 저장소에 올리지 말 것)

# 비밀키·환경변수
.env
.env.*
*.env
*.key
*.pem
*.p12
*.pfx
*.crt
# 이름에 secret/credential/token 이 들어간 파일 (실수 방지)
*secret*
*credential*
*token*.json
service_role*
id_rsa
id_ed25519
# Supabase CLI 임시/로컬 자료
supabase/.temp/
supabase/.branches/

# 내부 문서/내보낸 데이터
*.pptx
*.xlsx
*.csv

# 화면 캡처·스크린샷 (민감정보 포함 가능)
화면 캡처.png
*-screenshot.png
*_screenshot.png

# OS·에디터 부산물
.DS_Store
Thumbs.db

# 빌드 도구 부산물 (CI에서 자동 생성되므로 저장소에 올리지 않음)
node_modules/
dist/
